# Example environment for the Premier League static refresh.
# Copy to `.env.sync` and fill in real values — never commit the real file.
#
# The sync client reads the token ONLY from FOOTBALL_DATA_API_KEY (via
# `.env.sync`, loaded by scripts/load-sync-env.ts). Values here are empty
# placeholders; do not put real secrets in this example file.

# football-data.org v4 API token (https://www.football-data.org/)
FOOTBALL_DATA_API_KEY=

# Optional: only needed once AUTO_DEPLOY_ENABLED is switched on.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
