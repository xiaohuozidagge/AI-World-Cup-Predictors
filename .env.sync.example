# Template for the local-only CLI sync environment.
#
# Copy this file to `.env.sync` and fill in the real value. `.env.sync` is
# gitignored and is NOT auto-loaded by Next.js — it is only read by the CLI
# sync scripts (sync:data, check:standings) via scripts/load-sync-env.ts.
#
# This value is a SECRET and must never be NEXT_PUBLIC-prefixed or committed.
FOOTBALL_DATA_API_KEY=
